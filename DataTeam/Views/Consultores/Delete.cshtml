@model DataTeam.Models.Consultor
@{
    ViewData["Title"] = "Deshabilitar Consultor";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Deshabilitar Consultor
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i>
                        <strong>Atención:</strong> Esta acción no eliminará el registro permanentemente. 
                        El consultor será marcado como "deshabilitado" y podrá ser restaurado posteriormente.
                    </div>

                    <div class="text-center mb-4">
                        <img src="@(string.IsNullOrEmpty(Model.RutaFoto) ? "/images/default-avatar.svg" : Model.RutaFoto)" 
                             alt="@Model.Nombre" 
                             class="rounded-circle border border-3 border-danger"
                             style="width: 150px; height: 150px; object-fit: cover;">
                    </div>

                    <h4 class="text-center mb-4">@Model.Nombre</h4>

                    <dl class="row">
                        <dt class="col-sm-4">Cédula:</dt>
                        <dd class="col-sm-8">@Model.Cedula</dd>

                        <dt class="col-sm-4">Correo:</dt>
                        <dd class="col-sm-8">@Model.Correo</dd>

                        <dt class="col-sm-4">Cargo:</dt>
                        <dd class="col-sm-8">@Model.Cargo</dd>

                        <dt class="col-sm-4">Célula:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Celula != null)
                            {
                                <span class="badge" style="background-color: @Model.Celula.Color">
                                    @Model.Celula.Nombre
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Sin asignar</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Estado:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Estado == DataTeam.Models.EstadoConsultor.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Retirado</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg" 
                                    onclick="return confirm('¿Está seguro de deshabilitar este consultor?')">
                                <i class="bi bi-trash"></i> Confirmar Deshabilitación
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
