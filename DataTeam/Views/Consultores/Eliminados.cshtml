@model List<DataTeam.Models.Consultor>
@{
    ViewData["Title"] = "Consultores Deshabilitados";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-archive"></i> Consultores Deshabilitados
        </h2>
        <a asp-action="Index" class="btn btn-primary">
            <i class="bi bi-arrow-left"></i> Volver a Consultores
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                <i class="bi bi-person-slash"></i> Lista de Consultores Deshabilitados
            </h5>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No hay consultores deshabilitados en este momento.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Foto</th>
                                <th>Cédula</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Cargo</th>
                                <th>Célula</th>
                                <th>Fecha Deshabilitado</th>
                                <th>Deshabilitado Por</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var consultor in Model)
                            {
                                <tr class="table-secondary">
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(consultor.RutaFoto) ? "/images/default-avatar.svg" : consultor.RutaFoto)" 
                                             alt="@consultor.Nombre" 
                                             class="rounded-circle" 
                                             style="width: 40px; height: 40px; object-fit: cover;">
                                    </td>
                                    <td>@consultor.Cedula</td>
                                    <td>
                                        <strong>@consultor.Nombre</strong>
                                    </td>
                                    <td>@consultor.Correo</td>
                                    <td>@consultor.Cargo</td>
                                    <td>
                                        @if (consultor.Celula != null)
                                        {
                                            <span class="badge" style="background-color: @consultor.Celula.Color">
                                                @consultor.Celula.Nombre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin asignar</span>
                                        }
                                    </td>
                                    <td>
                                        @if (consultor.FechaEliminacion.HasValue)
                                        {
                                            <small>@consultor.FechaEliminacion.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@(consultor.EliminadoPor ?? "Sistema")</small>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@consultor.Id" 
                                               class="btn btn-sm btn-info" title="Ver Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <form asp-action="Restaurar" asp-route-id="@consultor.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success" 
                                                        onclick="return confirm('¿Está seguro de restaurar este consultor?')"
                                                        title="Restaurar">
                                                    <i class="bi bi-arrow-clockwise"></i> Restaurar
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <small class="text-muted">
                        Total de consultores deshabilitados: <strong>@Model.Count</strong>
                    </small>
                </div>
            }
        </div>
    </div>

    <div class="alert alert-warning mt-4">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>Nota:</strong> Los consultores deshabilitados no se eliminan del sistema. 
        Puedes restaurarlos en cualquier momento usando el botón "Restaurar".
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
