@model List<DataTeam.Models.Consultor>
@{
    ViewData["Title"] = "Consultores";
}

<div class="container-fluid py-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold text-primary">
            <i class="bi bi-people-fill"></i> Gestión de Consultores
        </h1>
        <p class="lead text-muted fs-4">Administra el equipo completo de DataTeam</p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-success btn-lg shadow">
                    <i class="bi bi-plus-circle-fill"></i> Nuevo Consultor
                </a>
                <a asp-action="ExportarExcel" class="btn btn-outline-success btn-lg shadow ms-2">
                    <i class="bi bi-file-earmark-excel-fill"></i> Exportar Excel
                </a>
            }
        </div>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-action="Eliminados" class="btn btn-outline-warning btn-lg">
                <i class="bi bi-archive-fill"></i> Ver Deshabilitados
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm fs-5" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm fs-5" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Panel de Filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-funnel-fill me-2"></i>Filtros de Búsqueda
            </h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <!-- Búsqueda general -->
                <div class="col-md-3">
                    <label for="buscar" class="form-label">
                        <i class="bi bi-search"></i> Buscar
                    </label>
                    <input type="text" 
                           class="form-control" 
                           id="buscar" 
                           name="buscar" 
                           placeholder="Nombre, cédula, correo..." 
                           value="@ViewBag.BuscarActual" />
                </div>

                <!-- Filtro por Célula -->
                <div class="col-md-2">
                    <label for="celulaId" class="form-label">
                        <i class="bi bi-diagram-3"></i> Célula
                    </label>
                    <select class="form-select" id="celulaId" name="celulaId">
                        <option value="">Todas</option>
                        @foreach (var celula in ViewBag.Celulas as List<DataTeam.Models.Celula>)
                        {
                            <option value="@celula.Id" selected="@(ViewBag.CelulaIdActual == celula.Id)">
                                @celula.Nombre
                            </option>
                        }
                    </select>
                </div>

                <!-- Filtro por Estado -->
                <div class="col-md-2">
                    <label for="estado" class="form-label">
                        <i class="bi bi-toggle-on"></i> Estado
                    </label>
                    <select class="form-select" id="estado" name="estado">
                        <option value="">Todos</option>
                        <option value="@((int)DataTeam.Models.EstadoConsultor.Activo)" 
                                selected="@(ViewBag.EstadoActual == DataTeam.Models.EstadoConsultor.Activo)">
                            Activo
                        </option>
                        <option value="@((int)DataTeam.Models.EstadoConsultor.Retirado)" 
                                selected="@(ViewBag.EstadoActual == DataTeam.Models.EstadoConsultor.Retirado)">
                            Retirado
                        </option>
                    </select>
                </div>

                <!-- Filtro por Cargo -->
                <div class="col-md-2">
                    <label for="cargo" class="form-label">
                        <i class="bi bi-briefcase"></i> Cargo
                    </label>
                    <select class="form-select" id="cargo" name="cargo">
                        <option value="">Todos</option>
                        @foreach (var cargoItem in ViewBag.Cargos as List<string>)
                        {
                            <option value="@cargoItem" selected="@(ViewBag.CargoActual == cargoItem)">
                                @cargoItem
                            </option>
                        }
                    </select>
                </div>

                <!-- Ordenar por -->
                <div class="col-md-2">
                    <label for="ordenarPor" class="form-label">
                        <i class="bi bi-sort-down"></i> Ordenar por
                    </label>
                    <select class="form-select" id="ordenarPor" name="ordenarPor">
                        <option value="">Por defecto</option>
                        <option value="celula" selected="@(ViewBag.OrdenarPorActual == "celula")">Célula</option>
                        <option value="estado" selected="@(ViewBag.OrdenarPorActual == "estado")">Estado</option>
                        <option value="cargo" selected="@(ViewBag.OrdenarPorActual == "cargo")">Cargo</option>
                        <option value="fecha_nuevo" selected="@(ViewBag.OrdenarPorActual == "fecha_nuevo")">Más nuevo primero</option>
                        <option value="fecha_antiguo" selected="@(ViewBag.OrdenarPorActual == "fecha_antiguo")">Más antiguo primero</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                </div>

                <div class="col-md-12">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-circle"></i> Limpiar Filtros
                    </a>
                    @if (Model != null && Model.Any())
                    {
                        <span class="badge bg-info text-dark ms-2 fs-6">
                            <i class="bi bi-people"></i> @Model.Count consultor@(Model.Count == 1 ? "" : "es") encontrado@(Model.Count == 1 ? "" : "s")
                        </span>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient text-white py-4">
            <h3 class="mb-0">
                <i class="bi bi-list-ul"></i> Lista de Consultores
            </h3>
        </div>
        <div class="card-body p-4">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center fs-4 py-5">
                    <i class="bi bi-info-circle display-3 d-block mb-3"></i>
                    <p class="mb-0">No hay consultores registrados en el sistema.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle fs-5">
                        <thead class="table-dark">
                            <tr>
                                <th class="py-3">Foto</th>
                                <th class="py-3">Cédula</th>
                                <th class="py-3">Nombre</th>
                                <th class="py-3">Correo</th>
                                <th class="py-3">Cargo</th>
                                <th class="py-3">Célula</th>
                                <th class="py-3">Fecha Ingreso</th>
                                <th class="py-3">Estado</th>
                                <th class="py-3 text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var consultor in Model)
                            {
                                <tr class="hover-row">
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(consultor.RutaFoto) ? "/images/default-avatar.svg" : consultor.RutaFoto)" 
                                             alt="@consultor.Nombre" 
                                             class="rounded-circle border border-3 border-primary" 
                                             style="width: 60px; height: 60px; object-fit: cover;">
                                    </td>
                                    <td class="fw-bold">@consultor.Cedula</td>
                                    <td>
                                        <strong class="text-primary fs-5">@consultor.Nombre</strong>
                                    </td>
                                    <td>
                                        <a href="mailto:@consultor.Correo" class="text-decoration-none">
                                            <i class="bi bi-envelope"></i> @consultor.Correo
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark fs-6 px-3 py-2">@consultor.Cargo</span>
                                    </td>
                                    <td>
                                        @if (consultor.Celula != null)
                                        {
                                            <span class="badge fs-6 px-3 py-2" style="background-color: @consultor.Celula.Color">
                                                <i class="bi bi-grid-3x3"></i> @consultor.Celula.Nombre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin asignar</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar-event"></i> @consultor.FechaIngreso.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @if (consultor.Estado == DataTeam.Models.EstadoConsultor.Activo)
                                        {
                                            <span class="badge bg-success fs-6 px-3 py-2">
                                                <i class="bi bi-check-circle"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6 px-3 py-2">
                                                <i class="bi bi-x-circle"></i> Retirado
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@consultor.Id" 
                                               class="btn btn-info btn-lg" title="Ver Detalles">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@consultor.Id" 
                                                   class="btn btn-warning btn-lg" title="Editar">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </a>
                                            }
                                            @if (User.IsInRole("SuperAdmin"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@consultor.Id" 
                                                   class="btn btn-danger btn-lg" title="Deshabilitar">
                                                    <i class="bi bi-trash-fill"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 p-4 bg-light rounded">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="stat-box">
                                <i class="bi bi-people display-4 text-primary"></i>
                                <h3 class="fw-bold mt-2">@Model.Count</h3>
                                <p class="text-muted mb-0">Total Consultores</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-box">
                                <i class="bi bi-check-circle display-4 text-success"></i>
                                <h3 class="fw-bold mt-2">@Model.Count(c => c.Estado == DataTeam.Models.EstadoConsultor.Activo)</h3>
                                <p class="text-muted mb-0">Activos</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-box">
                                <i class="bi bi-grid-3x3 display-4 text-info"></i>
                                <h3 class="fw-bold mt-2">@Model.Select(c => c.CelulaId).Distinct().Count()</h3>
                                <p class="text-muted mb-0">Células</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .bg-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .hover-row {
            transition: all 0.3s ease;
        }

        .hover-row:hover {
            transform: scale(1.02);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
        }

        .stat-box {
            padding: 2rem;
            transition: transform 0.3s ease;
        }

        .stat-box:hover {
            transform: translateY(-10px);
        }

        .btn-lg {
            padding: 0.75rem 1.5rem;
            font-size: 1.1rem;
        }

        .table th, .table td {
            vertical-align: middle;
            padding: 1.2rem 1rem;
        }

        .display-3 {
            font-size: 4rem;
        }
    </style>
}
