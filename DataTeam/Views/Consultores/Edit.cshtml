@model DataTeam.ViewModels.ConsultorViewModel
@{
    ViewData["Title"] = "Editar Consultor";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Editar Consultor
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="RutaFoto" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cedula" class="form-label"></label>
                                <input asp-for="Cedula" class="form-control" />
                                <span asp-validation-for="Cedula" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label"></label>
                                <input asp-for="Correo" class="form-control" type="email" />
                                <span asp-validation-for="Correo" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Cargo" class="form-label"></label>
                                <input asp-for="Cargo" class="form-control" />
                                <span asp-validation-for="Cargo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaIngreso" class="form-label"></label>
                                <input asp-for="FechaIngreso" class="form-control" type="date" />
                                <span asp-validation-for="FechaIngreso" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaNacimiento" class="form-label"></label>
                                <input asp-for="FechaNacimiento" class="form-control" type="date" id="fechaNacimiento" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                                <small class="form-text text-muted">No puede ser una fecha futura</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Celular" class="form-label"></label>
                                <input asp-for="Celular" class="form-control" />
                                <span asp-validation-for="Celular" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CelularEmergencia" class="form-label"></label>
                                <input asp-for="CelularEmergencia" class="form-control" />
                                <span asp-validation-for="CelularEmergencia" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(Model.RutaFoto))
                            {
                                <div class="mb-2">
                                    <label class="form-label">Foto actual:</label><br/>
                                    <img src="@Model.RutaFoto" alt="Foto actual" class="img-thumbnail" style="max-width: 150px;" />
                                </div>
                            }
                            <label asp-for="FotoFile" class="form-label">Cambiar foto</label>
                            <input asp-for="FotoFile" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="FotoFile" class="text-danger"></span>
                            <small class="form-text text-muted">Tamaño máximo: 5MB. Formatos: JPG, PNG, GIF</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-pencil-square"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <script>
        // Validación de fecha de nacimiento: no puede ser futura
        document.addEventListener('DOMContentLoaded', function() {
            const fechaNacimiento = document.getElementById('fechaNacimiento');
            if (fechaNacimiento) {
                // Establecer la fecha máxima como hoy
                const today = new Date().toISOString().split('T')[0];
                fechaNacimiento.setAttribute('max', today);

                // Validación adicional en tiempo real
                fechaNacimiento.addEventListener('change', function() {
                    const selectedDate = new Date(this.value);
                    const todayDate = new Date();
                    todayDate.setHours(0, 0, 0, 0);

                    if (selectedDate > todayDate) {
                        alert('La fecha de nacimiento no puede ser en el futuro');
                        this.value = today;
                    }
                });
            }
        });
    </script>
}
