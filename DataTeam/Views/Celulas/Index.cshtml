@model IEnumerable<DataTeam.Models.Celula>
@{
    ViewData["Title"] = "Células de Trabajo";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h2 class="text-success fw-bold mb-0">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i>Células de Trabajo
            </h2>
            <p class="text-muted mb-0 small">Listado de células con imagen, líderes y miembros.</p>
        </div>
        @if (User.IsInRole(AppRoles.SuperAdmin))
        {
            <a asp-action="Create" class="btn btn-dark btn-lg px-4">
                <i class="bi bi-plus-circle me-1"></i>Crear Célula
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-light border alert-dismissible fade show d-flex align-items-center gap-2 mt-3" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mt-1">
        @foreach (var celula in Model)
        {
            var liderPrincipal = celula.CelulaLideres.FirstOrDefault(cl => cl.EsLiderPrincipal)
                              ?? celula.CelulaLideres.FirstOrDefault();
            var totalMiembros = celula.Consultores?.Count ?? 0;

            <div class="col-md-6 col-lg-4">
                <div class="card celula-card h-100 shadow-sm border-0 overflow-hidden">

                    <!-- Imagen de portada -->
                    <div class="celula-cover position-relative"
                         style="height:180px; background: @(string.IsNullOrEmpty(celula.ImagenUrl) ? (celula.Color ?? "#28a745") : "transparent");">
                        @if (!string.IsNullOrEmpty(celula.ImagenUrl))
                        {
                            <img src="@celula.ImagenUrl" alt="@celula.Nombre"
                                 class="w-100 h-100 object-fit-cover" />
                        }
                        <div class="position-absolute top-0 start-0 w-100 h-100"
                             style="background: rgba(0,0,0,0.25);"></div>
                        <span class="position-absolute top-0 start-50 translate-middle-x mt-2
                                     badge text-white text-uppercase letter-spacing-1"
                              style="background:rgba(0,0,0,0.35); font-size:.65rem; letter-spacing:2px;">
                            CÉLULA
                        </span>
                        <h5 class="position-absolute bottom-0 start-0 text-white fw-bold px-3 pb-2 mb-0"
                            style="text-shadow:0 1px 4px rgba(0,0,0,.6);">
                            @celula.Nombre
                        </h5>
                    </div>

                    <!-- Cuerpo -->
                    <div class="card-body pb-2">
                        @if (!string.IsNullOrEmpty(celula.Descripcion))
                        {
                            <p class="text-muted small mb-3">
                                <i class="bi bi-card-text me-1"></i>@celula.Descripcion
                            </p>
                        }

                        <!-- Líder -->
                        @if (liderPrincipal != null)
                        {
                            <div class="d-flex align-items-center border rounded px-3 py-2 mb-3 gap-2">
                                <i class="bi bi-person-circle fs-5 text-muted"></i>
                                <span class="fw-semibold">@liderPrincipal.Consultor?.Nombre</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center border rounded px-3 py-2 mb-3 gap-2 text-warning">
                                <i class="bi bi-exclamation-circle fs-5"></i>
                                <span>Sin líderes asignados</span>
                            </div>
                        }

                        <!-- Miembros -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                <p class="text-muted small mb-0">Miembros</p>
                                <h3 class="fw-bold mb-0">@totalMiembros</h3>
                            </div>
                            <a asp-action="Details" asp-route-id="@celula.Id"
                               class="btn btn-info rounded-circle p-0 d-flex align-items-center justify-content-center"
                               style="width:40px;height:40px;" title="Ver miembros">
                                <i class="bi bi-people-fill text-white"></i>
                            </a>
                        </div>

                        <p class="text-muted small mb-2">
                            <i class="bi bi-calendar me-1"></i>Creada: @celula.FechaCreacion.ToShortDateString()
                            <span class="ms-2 badge @(celula.Activa ? "bg-success" : "bg-secondary")">
                                @(celula.Activa ? "Activa" : "Inactiva")
                            </span>
                        </p>
                    </div>

                    <!-- Botones gestión -->
                    <div class="card-footer p-0 border-0">
                        <div class="btn-group w-100 rounded-0" role="group">
                            <a asp-action="Details" asp-route-id="@celula.Id"
                               class="btn btn-outline-success rounded-0 py-2">
                                <i class="bi bi-eye-fill me-1"></i>Ver
                            </a>
                            @if (User.IsInRole(AppRoles.SuperAdmin))
                            {
                                <a asp-action="Edit" asp-route-id="@celula.Id"
                                   class="btn btn-dark rounded-0 py-2" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@celula.Id"
                                   class="btn btn-dark rounded-0 py-2" title="Eliminar">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-4">
            <i class="bi bi-info-circle me-2"></i>No hay células registradas.
            @if (User.IsInRole(AppRoles.SuperAdmin))
            {
                <a asp-action="Create" class="alert-link">Crear la primera célula</a>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .celula-card { transition: transform .2s, box-shadow .2s; border-radius: 12px !important; }
        .celula-card:hover { transform: translateY(-4px); box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.15) !important; }
        .celula-cover img { object-fit: cover; }
    </style>
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Células de Trabajo</h2>
        @if (User.IsInRole(AppRoles.SuperAdmin))
        {
            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle-fill me-1"></i>Crear Célula
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        @foreach (var celula in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header" style="background-color: @(celula.Color ?? "#17a2b8"); color: white;">
                        <h5 class="mb-0">
                            @celula.Nombre
                            @if (!celula.Activa)
                            {
                                <span class="badge bg-secondary">Inactiva</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(celula.Descripcion))
                        {
                            <p class="card-text text-muted">@celula.Descripcion</p>
                        }

                        <div class="mb-3">
                            <h6 class="text-primary"><i class="bi bi-star-fill me-1"></i>Líderes:</h6>
                            @if (celula.CelulaLideres.Any())
                            {
                                var liderPrincipal = celula.CelulaLideres.FirstOrDefault(cl => cl.EsLiderPrincipal);
                                @if (liderPrincipal != null)
                                {
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-person-badge text-warning me-2" style="font-size: 1.2rem;"></i>
                                        <div>
                                            <strong>@liderPrincipal.Consultor?.Nombre</strong>
                                            <span class="badge bg-warning text-dark ms-2">Principal</span>
                                        </div>
                                    </div>
                                }

                                var otrosLideres = celula.CelulaLideres.Where(cl => !cl.EsLiderPrincipal).ToList();
                                @if (otrosLideres.Any())
                                {
                                    <div class="text-muted small">
                                        + @otrosLideres.Count otro@(otrosLideres.Count != 1 ? "s" : "") líder@(otrosLideres.Count != 1 ? "es" : "")
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">Sin líderes asignados</p>
                            }
                        </div>

                        <div class="mb-2">
                            <h6 class="text-info"><i class="bi bi-people me-1"></i>Miembros:</h6>
                            <p class="mb-0">
                                @{
                                    var totalMiembros = celula.CelulaMiembros?.Count ?? 0;
                                }
                                <span class="badge bg-info fs-6">@totalMiembros</span> 
                                <span class="text-muted">miembro@(totalMiembros != 1 ? "s" : "") activo@(totalMiembros != 1 ? "s" : "")</span>
                            </p>
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> Haz clic en "Ver detalles" para ver la lista completa
                            </small>
                        </div>

                        <small class="text-muted">
                            <i class="bi bi-calendar me-1"></i>
                            Creada: @celula.FechaCreacion.ToShortDateString()
                        </small>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="btn-group w-100" role="group">
                            <a asp-action="Details" asp-route-id="@celula.Id" class="btn btn-sm btn-outline-success" title="Ver detalles">
                                <i class="bi bi-eye-fill"></i> Ver
                            </a>
                            @if (User.IsInRole(AppRoles.SuperAdmin))
                            {
                                <a asp-action="Edit" asp-route-id="@celula.Id" class="btn btn-sm btn-warning" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@celula.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle me-2"></i>
            No hay células registradas. 
            @if (User.IsInRole(AppRoles.SuperAdmin))
            {
                <a asp-action="Create" class="alert-link">Crear la primera célula</a>
            }
        </div>
    }
</div>
