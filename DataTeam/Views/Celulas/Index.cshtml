@model IEnumerable<DataTeam.Models.Celula>
@{
    ViewData["Title"] = "Gestión de Células";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Células de Trabajo</h2>
        @if (User.IsInRole(AppRoles.SuperAdmin))
        {
            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle-fill me-1"></i>Crear Célula
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        @foreach (var celula in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header" style="background-color: @(celula.Color ?? "#17a2b8"); color: white;">
                        <h5 class="mb-0">
                            @celula.Nombre
                            @if (!celula.Activa)
                            {
                                <span class="badge bg-secondary">Inactiva</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(celula.Descripcion))
                        {
                            <p class="card-text text-muted">@celula.Descripcion</p>
                        }

                        <div class="mb-3">
                            <h6 class="text-primary"><i class="bi bi-star-fill me-1"></i>Líderes:</h6>
                            @if (celula.CelulaLideres.Any())
                            {
                                var liderPrincipal = celula.CelulaLideres.FirstOrDefault(cl => cl.EsLiderPrincipal);
                                @if (liderPrincipal != null)
                                {
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-person-badge text-warning me-2" style="font-size: 1.2rem;"></i>
                                        <div>
                                            <strong>@liderPrincipal.Consultor?.Nombre</strong>
                                            <span class="badge bg-warning text-dark ms-2">Principal</span>
                                        </div>
                                    </div>
                                }

                                var otrosLideres = celula.CelulaLideres.Where(cl => !cl.EsLiderPrincipal).ToList();
                                @if (otrosLideres.Any())
                                {
                                    <div class="text-muted small">
                                        + @otrosLideres.Count otro@(otrosLideres.Count != 1 ? "s" : "") líder@(otrosLideres.Count != 1 ? "es" : "")
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">Sin líderes asignados</p>
                            }
                        </div>

                        <div class="mb-2">
                            <h6 class="text-info"><i class="bi bi-people me-1"></i>Miembros:</h6>
                            <p class="mb-0">
                                @{
                                    var totalMiembros = celula.CelulaMiembros?.Count ?? 0;
                                }
                                <span class="badge bg-info fs-6">@totalMiembros</span> 
                                <span class="text-muted">miembro@(totalMiembros != 1 ? "s" : "") activo@(totalMiembros != 1 ? "s" : "")</span>
                            </p>
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> Haz clic en "Ver detalles" para ver la lista completa
                            </small>
                        </div>

                        <small class="text-muted">
                            <i class="bi bi-calendar me-1"></i>
                            Creada: @celula.FechaCreacion.ToShortDateString()
                        </small>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="btn-group w-100" role="group">
                            <a asp-action="Details" asp-route-id="@celula.Id" class="btn btn-sm btn-outline-success" title="Ver detalles">
                                <i class="bi bi-eye-fill"></i> Ver
                            </a>
                            @if (User.IsInRole(AppRoles.SuperAdmin))
                            {
                                <a asp-action="Edit" asp-route-id="@celula.Id" class="btn btn-sm btn-warning" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@celula.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle me-2"></i>
            No hay células registradas. 
            @if (User.IsInRole(AppRoles.SuperAdmin))
            {
                <a asp-action="Create" class="alert-link">Crear la primera célula</a>
            }
        </div>
    }
</div>
