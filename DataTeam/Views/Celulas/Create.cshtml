@model DataTeam.Models.Celula
@{
    ViewData["Title"] = "Crear Célula";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Crear Nueva Célula</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Célula Innovation" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción de la célula..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Color" class="form-label"></label>
                            <input asp-for="Color" type="color" class="form-control form-control-color" value="#17a2b8" />
                            <small class="form-text text-muted">Color de fondo cuando no hay imagen</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-image me-1"></i>Imagen / Logo de la Célula</label>
                            <input type="file" name="imagenFile" class="form-control" accept="image/*" />
                            <small class="form-text text-muted">Formatos: JPG, PNG, GIF, WEBP. Se mostrará como portada de la tarjeta.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-star-fill text-warning me-1"></i>
                                Seleccionar Líderes de la Célula
                            </label>
                            <select name="lideresIds" class="form-select" multiple size="8">
                                @foreach (var consultor in (ViewBag.Consultores as MultiSelectList))
                                {
                                    <option value="@consultor.Value">@consultor.Text</option>
                                }
                            </select>
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Mantén presionado Ctrl (Windows) o Cmd (Mac) para seleccionar múltiples líderes. 
                                El primer líder seleccionado será el líder principal.
                            </small>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="Activa" class="form-check-input" checked />
                            <label asp-for="Activa" class="form-check-label"></label>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>Crear Célula
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
