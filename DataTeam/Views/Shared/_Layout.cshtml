<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DataTeam</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DataTeam.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-lg py-3" style="background: linear-gradient(135deg, #28a745 0%, #218838 100%);">
            <div class="container-fluid">
                <a class="navbar-brand fs-3 fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-diagram-3-fill text-warning"></i> <span class="text-white">Data</span><span class="text-warning">Team</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white px-3 fs-5" asp-area="" asp-controller="Organigrama" asp-action="Index">
                                <i class="bi bi-house-door-fill fs-4 me-2"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white px-3 fs-5" asp-area="" asp-controller="Consultores" asp-action="Index">
                                <i class="bi bi-people-fill fs-4 me-2"></i> Consultores
                            </a>
                        </li>
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white px-3 fs-5" asp-area="" asp-controller="Importacion" asp-action="Index">
                                    <i class="bi bi-cloud-upload-fill fs-4 me-2"></i> Importar CSV
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white px-3 fs-5" href="#" id="navbarComposicion" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-diagram-3-fill fs-4 me-2"></i> Composición
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0" aria-labelledby="navbarComposicion" style="background-color: #f8f9fa;">
                                    <li>
                                        <a class="dropdown-item fs-6 py-2 fw-semibold" asp-controller="Celulas" asp-action="Index">
                                            <i class="bi bi-grid-3x3-gap-fill fs-5 me-2 text-success"></i>Células
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item fs-6 py-2 fw-semibold" asp-controller="Organigrama" asp-action="Index">
                                            <i class="bi bi-diagram-2-fill fs-5 me-2 text-warning"></i>Organigrama
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white px-3 fs-5" asp-area="" asp-controller="Auditoria" asp-action="Index">
                                    <i class="bi bi-clock-history fs-4 me-2"></i> Auditoría
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white px-3 fs-5" asp-area="" asp-controller="Consultores" asp-action="Eliminados">
                                    <i class="bi bi-archive fs-4 me-2"></i> Deshabilitados
                                </a>
                            </li>

                        }

                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="text-white text-center py-4 mt-5 shadow-lg" style="background: linear-gradient(135deg, #218838 0%, #28a745 100%);">
        <div class="container text-center">
            <p class="mb-0 fs-5">
                &copy; 2026 - <span class="text-warning fw-bold">DataTeam</span> - Sistema de Gestión de Personal
                <span class="ms-3">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none">
                        <i class="bi bi-shield-lock"></i> Privacidad
                    </a>
                </span>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <style>
        .bg-gradient {
            background: #000000 !important;
        }

        .nav-link {
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .nav-link:hover {
            transform: translateY(-2px);
            background-color: rgba(255,255,255,0.1);
            border-radius: 8px;
        }

        .navbar-brand {
            transition: all 0.3s ease;
        }

        .navbar-brand:hover {
            transform: scale(1.05);
        }

        body {
            font-size: 1.1rem;
            background-color: #f5f5f5;
        }
    </style>
</body>
</html>
