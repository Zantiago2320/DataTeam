@model List<DataTeam.Models.AuditoriaLog>
@{
    ViewData["Title"] = "Registro de Auditoría";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-clock-history"></i> Registro de Auditoría
        </h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> Últimos Cambios del Sistema
            </h5>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No hay registros de auditoría disponibles.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th>Entidad</th>
                                <th>ID</th>
                                <th>Acción</th>
                                <th>IP</th>
                                <th>Detalles</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td class="text-nowrap">
                                        <small>@log.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        <strong>@(log.Usuario ?? "Sistema")</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.RolUsuario))
                                        {
                                            <span class="badge bg-@(log.RolUsuario == "SuperAdmin" ? "danger" : log.RolUsuario == "Admin" ? "warning" : "info")">
                                                @DataTeam.Models.AppRoles.GetDisplayName(log.RolUsuario)
                                            </span>
                                        }
                                    </td>
                                    <td>@log.Entidad</td>
                                    <td>
                                        <a asp-controller="Auditoria" asp-action="Entidad" 
                                           asp-route-tipo="@log.Entidad" 
                                           asp-route-id="@log.EntidadId" 
                                           class="btn btn-sm btn-outline-primary">
                                            #@log.EntidadId
                                        </a>
                                    </td>
                                    <td>
                                        @if (log.Accion == "Crear")
                                        {
                                            <span class="badge bg-success">Crear</span>
                                        }
                                        else if (log.Accion == "Editar")
                                        {
                                            <span class="badge bg-warning text-dark">Editar</span>
                                        }
                                        else if (log.Accion == "Deshabilitar")
                                        {
                                            <span class="badge bg-danger">Deshabilitar</span>
                                        }
                                        else if (log.Accion == "Restaurar")
                                        {
                                            <span class="badge bg-info">Restaurar</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@log.Accion</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@(log.DireccionIP ?? "N/A")</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.ValoresAnteriores) || !string.IsNullOrEmpty(log.ValoresNuevos))
                                        {
                                            <button type="button" class="btn btn-sm btn-info" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#detalleModal@(log.Id)">
                                                <i class="bi bi-eye"></i> Ver
                                            </button>

                                            <!-- Modal para detalles -->
                                            <div class="modal fade" id="detalleModal@(log.Id)" tabindex="-1">
                                                <div class="modal-dialog modal-xl">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-primary text-white">
                                                            <h5 class="modal-title">
                                                                <i class="bi bi-info-circle-fill me-2"></i>Detalles del Cambio
                                                            </h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <h6 class="text-primary">
                                                                    <i class="bi bi-person-badge"></i> Información del Cambio
                                                                </h6>
                                                                <dl class="row">
                                                                    <dt class="col-sm-3">Usuario:</dt>
                                                                    <dd class="col-sm-9">@(log.Usuario ?? "Sistema")</dd>

                                                                    <dt class="col-sm-3">Fecha y Hora:</dt>
                                                                    <dd class="col-sm-9">@log.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                                                                    <dt class="col-sm-3">Entidad:</dt>
                                                                    <dd class="col-sm-9">@log.Entidad #@log.EntidadId</dd>

                                                                    <dt class="col-sm-3">Acción:</dt>
                                                                    <dd class="col-sm-9">@log.Accion</dd>
                                                                </dl>
                                                            </div>

                                                            <hr />

                                                            @{
                                                                var formatter = ViewBag.FormatterService as DataTeam.Services.IAuditoriaLogFormatterService;
                                                                var cambios = formatter?.ObtenerCambiosDetallados(log.ValoresAnteriores, log.ValoresNuevos);
                                                            }

                                                            @if (cambios != null && cambios.Any())
                                                            {
                                                                <h6 class="text-primary mb-3">
                                                                    <i class="bi bi-arrow-left-right"></i> Cambios Realizados
                                                                </h6>

                                                                <div class="list-group mb-3">
                                                                    @foreach (var cambio in cambios)
                                                                    {
                                                                        <div class="list-group-item">
                                                                            <div class="d-flex justify-content-between align-items-start">
                                                                                <div class="flex-grow-1">
                                                                                    <h6 class="mb-2">
                                                                                        <i class="bi bi-pencil-square text-primary me-1"></i>
                                                                                        <strong>@cambio.NombreAmigable</strong>
                                                                                        @if (cambio.TipoCambio == "Agregado")
                                                                                        {
                                                                                            <span class="badge bg-success ms-2">Nuevo</span>
                                                                                        }
                                                                                        else if (cambio.TipoCambio == "Eliminado")
                                                                                        {
                                                                                            <span class="badge bg-danger ms-2">Eliminado</span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span class="badge bg-warning text-dark ms-2">Modificado</span>
                                                                                        }
                                                                                    </h6>

                                                                                    <p class="mb-2 text-muted">
                                                                                        <i class="bi bi-info-circle"></i> @cambio.Descripcion
                                                                                    </p>

                                                                                    <div class="row g-2">
                                                                                        @if (cambio.TipoCambio != "Agregado")
                                                                                        {
                                                                                            <div class="col-md-6">
                                                                                                <div class="p-2 border border-danger rounded bg-light">
                                                                                                    <small class="text-danger fw-bold">
                                                                                                        <i class="bi bi-dash-circle"></i> Antes:
                                                                                                    </small>
                                                                                                    <div class="mt-1">
                                                                                                        <span class="text-decoration-line-through text-danger">
                                                                                                            @cambio.ValorAnterior
                                                                                                        </span>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        }

                                                                                        @if (cambio.TipoCambio != "Eliminado")
                                                                                        {
                                                                                            <div class="col-md-6">
                                                                                                <div class="p-2 border border-success rounded bg-light">
                                                                                                    <small class="text-success fw-bold">
                                                                                                        <i class="bi bi-plus-circle"></i> Después:
                                                                                                    </small>
                                                                                                    <div class="mt-1">
                                                                                                        <span class="fw-bold text-success">
                                                                                                            @cambio.ValorNuevo
                                                                                                        </span>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }

                                                            <hr />

                                                            <details class="mt-3">
                                                                <summary class="btn btn-sm btn-outline-secondary">
                                                                    <i class="bi bi-code-square"></i> Ver JSON Técnico
                                                                </summary>
                                                                <div class="row mt-3">
                                                                    @if (!string.IsNullOrEmpty(log.ValoresAnteriores))
                                                                    {
                                                                        <div class="col-md-6">
                                                                            <h6 class="text-danger">
                                                                                <i class="bi bi-file-code"></i> JSON Anterior
                                                                            </h6>
                                                                            <pre class="bg-light p-3 rounded" style="max-height: 300px; overflow-y: auto;"><code>@log.ValoresAnteriores</code></pre>
                                                                        </div>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(log.ValoresNuevos))
                                                                    {
                                                                        <div class="col-md-6">
                                                                            <h6 class="text-success">
                                                                                <i class="bi bi-file-code"></i> JSON Nuevo
                                                                            </h6>
                                                                            <pre class="bg-light p-3 rounded" style="max-height: 300px; overflow-y: auto;"><code>@log.ValoresNuevos</code></pre>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </details>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                                <i class="bi bi-x-circle"></i> Cerrar
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        <small class="text-muted">
                            Mostrando @Model.Count registros
                        </small>
                    </div>
                    <div>
                        @{
                            var paginaActual = (int?)ViewBag.PaginaActual ?? 1;
                            var registrosPorPagina = (int?)ViewBag.RegistrosPorPagina ?? 50;
                        }
                        @if (paginaActual > 1)
                        {
                            <a asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-registrosPorPagina="@registrosPorPagina" 
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-left"></i> Anterior
                            </a>
                        }
                        @if (Model.Count == registrosPorPagina)
                        {
                            <a asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-registrosPorPagina="@registrosPorPagina" 
                               class="btn btn-sm btn-outline-primary">
                                Siguiente <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
