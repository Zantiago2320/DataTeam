@model DataTeam.ViewModels.OrganigramaViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-success fw-bold mb-0">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i>Células de Trabajo
            </h2>
            <p class="text-muted mb-0 small">Estructura organizacional del equipo DataTeam</p>
        </div>
        <div class="d-flex gap-2">
            <div class="text-center px-3 py-2 bg-white rounded shadow-sm">
                <div class="fw-bold fs-4 text-success">@(Model.Celulas?.Count() ?? 0)</div>
                <div class="text-muted small">Células</div>
            </div>
            <div class="text-center px-3 py-2 bg-white rounded shadow-sm">
                <div class="fw-bold fs-4 text-success">@(Model.Celulas?.Sum(c => c.Consultores.Count) ?? 0)</div>
                <div class="text-muted small">Integrantes</div>
            </div>
        </div>
    </div>

    @if (Model.Celulas == null || !Model.Celulas.Any())
    {
        <div class="alert alert-info text-center fs-5">
            <i class="bi bi-info-circle"></i> No hay células configuradas en el sistema.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var celula in Model.Celulas)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card celula-home-card h-100 shadow-sm border-0 overflow-hidden">

                        <!-- Portada -->
                        <div class="celula-cover position-relative"
                             style="height:160px; background: @(string.IsNullOrEmpty(celula.ImagenUrl) ? (celula.Color ?? "#28a745") : "transparent");">
                            @if (!string.IsNullOrEmpty(celula.ImagenUrl))
                            {
                                <img src="@celula.ImagenUrl" alt="@celula.Nombre"
                                     class="w-100 h-100" style="object-fit:cover;" />
                            }
                            <div class="position-absolute top-0 start-0 w-100 h-100"
                                 style="background:rgba(0,0,0,0.22);"></div>
                            <span class="position-absolute top-0 start-50 translate-middle-x mt-2 badge text-white text-uppercase"
                                  style="background:rgba(0,0,0,0.32);font-size:.62rem;letter-spacing:2px;">
                                CÉLULA
                            </span>
                            <h5 class="position-absolute bottom-0 start-0 text-white fw-bold px-3 pb-2 mb-0"
                                style="text-shadow:0 1px 4px rgba(0,0,0,.5);">
                                @celula.Nombre
                            </h5>
                        </div>

                        <!-- Cuerpo -->
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(celula.Descripcion))
                            {
                                <p class="text-muted small mb-3">
                                    <i class="bi bi-card-text me-1"></i>@celula.Descripcion
                                </p>
                            }

                            <!-- Líder -->
                            @if (!string.IsNullOrEmpty(celula.NombreLider))
                            {
                                <div class="d-flex align-items-center border rounded px-3 py-2 mb-3 gap-2">
                                    <i class="bi bi-person-circle fs-5 text-muted"></i>
                                    <span class="fw-semibold">@celula.NombreLider</span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center border rounded px-3 py-2 mb-3 gap-2 text-warning">
                                    <i class="bi bi-exclamation-circle fs-5"></i>
                                    <span>Sin líderes asignados</span>
                                </div>
                            }

                            <!-- Miembros -->
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted small mb-0">Miembros</p>
                                    <h3 class="fw-bold mb-0">@celula.Consultores.Count</h3>
                                </div>
                                <span class="btn btn-info rounded-circle p-0 d-flex align-items-center justify-content-center"
                                      style="width:40px;height:40px;pointer-events:none;">
                                    <i class="bi bi-people-fill text-white"></i>
                                </span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 pb-3 pt-0 px-3">
                            <span class="badge @(celula.Activa ? "bg-success" : "bg-secondary")">
                                @(celula.Activa ? "Activa" : "Inactiva")
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Estilos movidos al @section Styles del final del archivo *@

<div class="container-fluid py-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-success">
            <i class="bi bi-diagram-3-fill"></i> Organigrama de Células
        </h1>
        <p class="lead text-muted">Estructura organizacional del equipo DataTeam</p>
    </div>

    @if (Model.Celulas == null || !Model.Celulas.Any())
    {
        <div class="alert alert-info text-center fs-5">
            <i class="bi bi-info-circle"></i> No hay células configuradas en el sistema.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var celula in Model.Celulas)
            {
                <div class="col">
                    <div class="card h-100 shadow-lg border-0 hover-lift" style="border-left: 5px solid @celula.Color !important;">
                        <div class="card-header text-white fw-bold fs-5" style="background-color: @celula.Color;">
                            <i class="bi bi-grid-3x3-gap-fill"></i> @celula.Nombre
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(celula.Descripcion))
                            {
                                <p class="text-muted mb-3">
                                    <i class="bi bi-card-text"></i> @celula.Descripcion
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(celula.NombreLider))
                            {
                                <div class="mb-3 p-3 bg-light rounded">
                                    <h6 class="text-success mb-2">
                                        <i class="bi bi-person-badge-fill"></i> Líder
                                    </h6>
                                    <p class="mb-0 fw-bold fs-5">@celula.NombreLider</p>
                                </div>
                            }

                            <div class="text-center p-4 bg-light rounded">
                                <i class="bi bi-people-fill text-success fs-1"></i>
                                <h3 class="mb-0 fw-bold text-success mt-2">@celula.Consultores.Count</h3>
                                <p class="text-muted mb-0">
                                    @(celula.Consultores.Count == 1 ? "Integrante" : "Integrantes")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-5">
            <div class="col-12">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-gradient bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-bar-chart-fill"></i> Resumen General
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row text-center g-4">
                            <div class="col-md-4">
                                <div class="p-4 bg-primary bg-opacity-10 rounded">
                                    <i class="bi bi-grid-3x3 text-primary display-4"></i>
                                    <h2 class="fw-bold mt-3">@Model.Celulas.Count()</h2>
                                    <p class="text-muted mb-0">Total Células</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-4 bg-success bg-opacity-10 rounded">
                                    <i class="bi bi-people text-success display-4"></i>
                                    <h2 class="fw-bold mt-3">@Model.Celulas.Sum(c => c.Consultores.Count)</h2>
                                    <p class="text-muted mb-0">Total Consultores</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-4 bg-info bg-opacity-10 rounded">
                                    <i class="bi bi-diagram-3 text-info display-4"></i>
                                    <h2 class="fw-bold mt-3">@Model.Celulas.Count(c => c.Consultores.Any())</h2>
                                    <p class="text-muted mb-0">Células Activas</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .celula-home-card { transition: transform .2s, box-shadow .2s; border-radius: 12px !important; }
        .celula-home-card:hover { transform: translateY(-4px); box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.12) !important; }
        .hover-lift {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .hover-lift:hover {
            transform: translateY(-10px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }

        .stat-card {
            padding: 1rem;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: scale(1.05);
        }

        .card-header {
            border: none;
            padding: 1.25rem;
        }

        .display-4 {
            font-size: 3.5rem;
        }

        .fs-5 {
            font-size: 1.25rem !important;
        }

        .bg-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
}
