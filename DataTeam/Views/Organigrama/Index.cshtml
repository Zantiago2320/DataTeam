@model DataTeam.ViewModels.OrganigramaViewModel
@{
    ViewData["Title"] = "Organigrama";
}

<div class="container-fluid py-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-success">
            <i class="bi bi-diagram-3-fill"></i> Organigrama de Células
        </h1>
        <p class="lead text-muted">Estructura organizacional del equipo DataTeam</p>
    </div>

    @if (Model.Celulas == null || !Model.Celulas.Any())
    {
        <div class="alert alert-info text-center fs-5">
            <i class="bi bi-info-circle"></i> No hay células configuradas en el sistema.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var celula in Model.Celulas)
            {
                <div class="col">
                    <div class="card h-100 shadow-lg border-0 hover-lift" style="border-left: 5px solid @celula.Color !important;">
                        <div class="card-header text-white fw-bold fs-5" style="background-color: @celula.Color;">
                            <i class="bi bi-grid-3x3-gap-fill"></i> @celula.Nombre
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(celula.Descripcion))
                            {
                                <p class="text-muted mb-3">
                                    <i class="bi bi-card-text"></i> @celula.Descripcion
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(celula.NombreLider))
                            {
                                <div class="mb-3 p-3 bg-light rounded">
                                    <h6 class="text-success mb-2">
                                        <i class="bi bi-person-badge-fill"></i> Líder
                                    </h6>
                                    <p class="mb-0 fw-bold fs-5">@celula.NombreLider</p>
                                </div>
                            }

                            <div class="text-center p-4 bg-light rounded">
                                <i class="bi bi-people-fill text-success fs-1"></i>
                                <h3 class="mb-0 fw-bold text-success mt-2">@celula.Consultores.Count</h3>
                                <p class="text-muted mb-0">
                                    @(celula.Consultores.Count == 1 ? "Integrante" : "Integrantes")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-5">
            <div class="col-12">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-gradient bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-bar-chart-fill"></i> Resumen General
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row text-center g-4">
                            <div class="col-md-4">
                                <div class="p-4 bg-primary bg-opacity-10 rounded">
                                    <i class="bi bi-grid-3x3 text-primary display-4"></i>
                                    <h2 class="fw-bold mt-3">@Model.Celulas.Count()</h2>
                                    <p class="text-muted mb-0">Total Células</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-4 bg-success bg-opacity-10 rounded">
                                    <i class="bi bi-people text-success display-4"></i>
                                    <h2 class="fw-bold mt-3">@Model.Celulas.Sum(c => c.Consultores.Count)</h2>
                                    <p class="text-muted mb-0">Total Consultores</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-4 bg-info bg-opacity-10 rounded">
                                    <i class="bi bi-diagram-3 text-info display-4"></i>
                                    <h2 class="fw-bold mt-3">@Model.Celulas.Count(c => c.Consultores.Any())</h2>
                                    <p class="text-muted mb-0">Células Activas</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .hover-lift {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .hover-lift:hover {
            transform: translateY(-10px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }

        .stat-card {
            padding: 1rem;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: scale(1.05);
        }

        .card-header {
            border: none;
            padding: 1.25rem;
        }

        .display-4 {
            font-size: 3.5rem;
        }

        .fs-5 {
            font-size: 1.25rem !important;
        }

        .bg-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
}
