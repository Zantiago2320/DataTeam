@model IEnumerable<DataTeam.Models.Equipo>
@{
    ViewData["Title"] = "Gestión de Equipos";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill me-2"></i>Equipos de Trabajo</h2>
        @if (User.IsInRole(AppRoles.SuperAdmin))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Crear Equipo
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        @foreach (var equipo in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header" style="background-color: @(equipo.Color ?? "#007bff"); color: white;">
                        <h5 class="mb-0">
                            @equipo.Nombre
                            @if (!equipo.Activo)
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(equipo.Descripcion))
                        {
                            <p class="card-text text-muted">@equipo.Descripcion</p>
                        }

                        <div class="mb-3">
                            <h6 class="text-primary"><i class="bi bi-star-fill me-1"></i>Líderes:</h6>
                            @if (equipo.EquipoLideres.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var lider in equipo.EquipoLideres.OrderByDescending(el => el.EsLiderPrincipal))
                                    {
                                        <li>
                                            <i class="bi bi-person-badge @(lider.EsLiderPrincipal ? "text-warning" : "text-secondary") me-1"></i>
                                            @lider.Consultor?.Nombre
                                            @if (lider.EsLiderPrincipal)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Principal</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">Sin líderes asignados</p>
                            }
                        </div>

                        <div class="mb-2">
                            <h6 class="text-info"><i class="bi bi-people me-1"></i>Miembros:</h6>
                            <p class="mb-0">
                                <span class="badge bg-info">@equipo.Consultores.Count</span> 
                                miembro@(equipo.Consultores.Count != 1 ? "s" : "")
                            </p>
                        </div>

                        <small class="text-muted">
                            <i class="bi bi-calendar me-1"></i>
                            Creado: @equipo.FechaCreacion.ToShortDateString()
                        </small>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="btn-group w-100" role="group">
                            <a asp-action="Details" asp-route-id="@equipo.Id" class="btn btn-sm btn-outline-info" title="Ver detalles">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (User.IsInRole(AppRoles.SuperAdmin))
                            {
                                <a asp-action="Edit" asp-route-id="@equipo.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="AsignarMiembros" asp-route-id="@equipo.Id" class="btn btn-sm btn-outline-success" title="Asignar miembros">
                                    <i class="bi bi-person-plus"></i>
                                </a>
                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@equipo.Id" />
                                    <input type="hidden" name="activo" value="@(!equipo.Activo)" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="@(equipo.Activo ? "Desactivar" : "Activar")">
                                        <i class="bi bi-@(equipo.Activo ? "pause" : "play")-circle"></i>
                                    </button>
                                </form>
                                <a asp-action="Delete" asp-route-id="@equipo.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle me-2"></i>
            No hay equipos registrados. 
            @if (User.IsInRole(AppRoles.SuperAdmin))
            {
                <a asp-action="Create" class="alert-link">Crear el primer equipo</a>
            }
        </div>
    }
</div>
