@{
    ViewData["Title"] = "Asignar Miembros";
    var equipo = ViewBag.Equipo as DataTeam.Models.Equipo;
    var miembrosActuales = ViewBag.MiembrosActuales as List<DataTeam.Models.Consultor> ?? new List<DataTeam.Models.Consultor>();
    var consultoresDisponibles = ViewBag.ConsultoresDisponibles as List<DataTeam.Models.Consultor> ?? new List<DataTeam.Models.Consultor>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-person-plus me-2"></i>
            Asignar Miembros: @equipo?.Nombre
        </h2>
        <a asp-action="Details" asp-route-id="@equipo?.Id" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Miembros Actuales -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>
                        Miembros Actuales (@miembrosActuales.Count)
                    </h5>
                </div>
                <div class="card-body">
                    @if (miembrosActuales.Any())
                    {
                        <div class="list-group">
                            @foreach (var miembro in miembrosActuales.OrderBy(m => m.Nombre))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">@miembro.Nombre</h6>
                                        <small class="text-muted">@miembro.Cargo</small>
                                    </div>
                                    <form asp-action="RemoverMiembro" method="post" class="d-inline">
                                        <input type="hidden" name="equipoId" value="@equipo?.Id" />
                                        <input type="hidden" name="consultorId" value="@miembro.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Remover a @miembro.Nombre del equipo?')">
                                            <i class="bi bi-x-circle"></i> Remover
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">No hay miembros asignados</p>
                    }
                </div>
            </div>
        </div>

        <!-- Consultores Disponibles -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>
                        Consultores Disponibles
                    </h5>
                </div>
                <div class="card-body">
                    @if (consultoresDisponibles.Any())
                    {
                        <div class="list-group" style="max-height: 500px; overflow-y: auto;">
                            @foreach (var consultor in consultoresDisponibles.OrderBy(c => c.Nombre))
                            {
                                var yaEsMiembro = miembrosActuales.Any(m => m.Id == consultor.Id);
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">@consultor.Nombre</h6>
                                        <small class="text-muted">
                                            @consultor.Cargo
                                            @if (consultor.Celula != null)
                                            {
                                                <span class="badge bg-info ms-1">@consultor.Celula.Nombre</span>
                                            }
                                        </small>
                                    </div>
                                    @if (yaEsMiembro)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Asignado
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-action="AsignarMiembro" method="post" class="d-inline">
                                            <input type="hidden" name="equipoId" value="@equipo?.Id" />
                                            <input type="hidden" name="consultorId" value="@consultor.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-plus-circle"></i> Asignar
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">No hay consultores disponibles</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
