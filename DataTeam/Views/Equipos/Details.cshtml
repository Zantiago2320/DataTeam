@model DataTeam.Models.Equipo
@{
    ViewData["Title"] = "Detalles del Equipo";
    var lideres = ViewBag.Lideres as List<DataTeam.Models.Consultor> ?? new List<DataTeam.Models.Consultor>();
    var miembros = ViewBag.Miembros as List<DataTeam.Models.Consultor> ?? new List<DataTeam.Models.Consultor>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-people-fill me-2" style="color: @(Model.Color ?? "#007bff")"></i>
            @Model.Nombre
        </h2>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
            @if (User.IsInRole(AppRoles.SuperAdmin))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            }
        </div>
    </div>

    <div class="row">
        <!-- Información General -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información General</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Estado:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Color:</dt>
                        <dd class="col-sm-8">
                            <span class="badge" style="background-color: @(Model.Color ?? "#007bff"); color: white;">
                                @(Model.Color ?? "#007bff")
                            </span>
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Descripcion))
                        {
                            <dt class="col-sm-12 mt-2">Descripción:</dt>
                            <dd class="col-sm-12">@Model.Descripcion</dd>
                        }

                        <dt class="col-sm-12 mt-2">Creado:</dt>
                        <dd class="col-sm-12">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>

                        @if (Model.FechaModificacion.HasValue)
                        {
                            <dt class="col-sm-12">Modificado:</dt>
                            <dd class="col-sm-12">@Model.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- Líderes del Equipo -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="bi bi-star-fill me-2"></i>Líderes del Equipo</h5>
                </div>
                <div class="card-body">
                    @if (lideres.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var lider in lideres)
                            {
                                var esLiderPrincipal = Model.EquipoLideres.FirstOrDefault(el => el.ConsultorId == lider.Id)?.EsLiderPrincipal ?? false;
                                <div class="list-group-item px-0">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            @if (!string.IsNullOrEmpty(lider.RutaFoto))
                                            {
                                                <img src="@lider.RutaFoto" alt="@lider.Nombre" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white" style="width: 50px; height: 50px;">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0">
                                                @lider.Nombre
                                                @if (esLiderPrincipal)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1">Principal</span>
                                                }
                                            </h6>
                                            <small class="text-muted">@lider.Cargo</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">No hay líderes asignados</p>
                    }
                </div>
            </div>
        </div>

        <!-- Miembros del Equipo -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>
                        Miembros (@miembros.Count)
                    </h5>
                </div>
                <div class="card-body">
                    @if (miembros.Any())
                    {
                        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                            @foreach (var miembro in miembros.OrderBy(m => m.Nombre))
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex align-items-center">
                                        <div class="me-2">
                                            @if (!string.IsNullOrEmpty(miembro.RutaFoto))
                                            {
                                                <img src="@miembro.RutaFoto" alt="@miembro.Nombre" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-info d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-person"></i>
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold">@miembro.Nombre</div>
                                            <small class="text-muted">@miembro.Cargo</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">No hay miembros asignados</p>
                    }

                    @if (User.IsInRole(AppRoles.SuperAdmin))
                    {
                        <a asp-action="AsignarMiembros" asp-route-id="@Model.Id" class="btn btn-success btn-sm w-100 mt-3">
                            <i class="bi bi-person-plus me-1"></i>Gestionar Miembros
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
