@model DataTeam.Models.Equipo
@{
    ViewData["Title"] = "Eliminar Equipo";
    var lideres = ViewBag.Lideres as List<DataTeam.Models.Consultor> ?? new List<DataTeam.Models.Consultor>();
    var miembros = ViewBag.Miembros as List<DataTeam.Models.Consultor> ?? new List<DataTeam.Models.Consultor>();
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>¿Está seguro que desea eliminar este equipo?</strong>
                        <br />Esta acción no se puede deshacer.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Equipo:</dt>
                        <dd class="col-sm-9">
                            <strong>@Model.Nombre</strong>
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Descripcion))
                        {
                            <dt class="col-sm-3">Descripción:</dt>
                            <dd class="col-sm-9">@Model.Descripcion</dd>
                        }

                        <dt class="col-sm-3">Estado:</dt>
                        <dd class="col-sm-9">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Líderes:</dt>
                        <dd class="col-sm-9">
                            @if (lideres.Any())
                            {
                                <ul class="mb-0">
                                    @foreach (var lider in lideres)
                                    {
                                        <li>@lider.Nombre</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">Sin líderes</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Miembros:</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-info">@miembros.Count</span> miembro(s)
                        </dd>
                    </dl>

                    @if (miembros.Any())
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-x-circle me-2"></i>
                            <strong>No se puede eliminar este equipo</strong>
                            <br />El equipo tiene @miembros.Count miembro(s) asignado(s). 
                            Primero debe reasignar o eliminar todos los miembros.
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger" @(miembros.Any() ? "disabled" : "")>
                                <i class="bi bi-trash me-1"></i>Eliminar Equipo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
