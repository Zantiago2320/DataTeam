@{
    ViewData["Title"] = "Importar Datos CSV - DataTeam";
}

<div class="container-fluid py-4">
    <div class="row mb-5">
        <div class="col-md-12">
            <h1 class="display-3 fw-bold mb-3">
                <i class="bi bi-cloud-upload-fill text-primary"></i>
                Importar Datos desde CSV
            </h1>
            <p class="text-muted fs-4">
                Sube un nuevo archivo CSV para actualizar la base de datos de empleados
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fs-5" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show fs-5" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Card de importación -->
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white py-4">
                    <h3 class="mb-0 fs-2">
                        <i class="bi bi-file-earmark-arrow-up me-2"></i>
                        Subir Archivo CSV
                    </h3>
                </div>
                <div class="card-body p-5">
                    <form asp-action="SubirCsv" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-5">
                            <label for="archivo" class="form-label fs-4 fw-bold">
                                <i class="bi bi-file-earmark-text me-2"></i>
                                Selecciona el archivo CSV
                            </label>
                            <input type="file" 
                                   class="form-control form-control-lg fs-4" 
                                   id="archivo" 
                                   name="archivo" 
                                   accept=".csv"
                                   required>
                            <div class="form-text fs-5 mt-3">
                                <i class="bi bi-info-circle me-1"></i>
                                El archivo debe estar en formato CSV y usar delimitadores compatibles (comas o punto y coma)
                            </div>
                        </div>

                        <div class="alert alert-warning fs-5" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>¡Importante!</strong> Se creará una copia de seguridad automática del archivo actual antes de la importación.
                        </div>

                        <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-4">
                            <a asp-controller="Empleados" asp-action="Index" class="btn btn-outline-secondary btn-lg fs-4 px-5">
                                <i class="bi bi-x-circle me-2"></i>
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg fs-4 px-5">
                                <i class="bi bi-upload me-2"></i>
                                Importar Archivo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Panel de ayuda -->
        <div class="col-lg-4">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-info text-white py-3">
                    <h4 class="mb-0 fs-3">
                        <i class="bi bi-download me-2"></i>
                        Plantilla CSV
                    </h4>
                </div>
                <div class="card-body p-4">
                    <p class="fs-5 mb-4">
                        Descarga una plantilla con la estructura correcta y un ejemplo de datos.
                    </p>
                    <a asp-action="DescargarPlantilla" class="btn btn-info btn-lg w-100 fs-4">
                        <i class="bi bi-file-earmark-arrow-down me-2"></i>
                        Descargar Plantilla
                    </a>
                </div>
            </div>

            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h4 class="mb-0 fs-3">
                        <i class="bi bi-lightbulb me-2"></i>
                        Requisitos
                    </h4>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0 fs-5">
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Archivo en formato <strong>.csv</strong>
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Codificación <strong>UTF-8</strong>
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Primera fila con <strong>encabezados</strong>
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Delimitadores: <strong>coma (,)</strong> o <strong>punto y coma (;)</strong>
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Campos de texto entre <strong>comillas</strong>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card shadow border-0 mt-4">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0 fs-3">
                        <i class="bi bi-clock-history me-2"></i>
                        Copias de Seguridad
                    </h4>
                </div>
                <div class="card-body p-4">
                    <p class="fs-5 mb-3">
                        <i class="bi bi-shield-check me-2"></i>
                        Cada importación genera automáticamente un backup con fecha y hora.
                    </p>
                    <p class="fs-5 text-muted mb-0">
                        <small>
                            <i class="bi bi-folder2-open me-1"></i>
                            Ubicación: <code>/Backups/</code>
                        </small>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Instrucciones detalladas -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient text-white py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="mb-0 fs-2">
                        <i class="bi bi-journal-text me-2"></i>
                        Instrucciones de Uso
                    </h3>
                </div>
                <div class="card-body p-5">
                    <div class="row">
                        <div class="col-md-6">
                            <h4 class="fs-3 mb-4">
                                <i class="bi bi-1-circle-fill text-primary me-2"></i>
                                Preparar el Archivo
                            </h4>
                            <ul class="fs-5 mb-4">
                                <li class="mb-3">Abre tu archivo Excel o Google Sheets</li>
                                <li class="mb-3">Verifica que la primera fila contenga los nombres de las columnas</li>
                                <li class="mb-3">Guarda como <strong>CSV (UTF-8)</strong> o descarga nuestra plantilla</li>
                                <li>Asegúrate de que las fechas estén en formato consistente</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h4 class="fs-3 mb-4">
                                <i class="bi bi-2-circle-fill text-primary me-2"></i>
                                Importar Datos
                            </h4>
                            <ul class="fs-5 mb-4">
                                <li class="mb-3">Haz clic en <strong>"Selecciona el archivo CSV"</strong></li>
                                <li class="mb-3">Elige tu archivo preparado</li>
                                <li class="mb-3">Presiona <strong>"Importar Archivo"</strong></li>
                                <li>El sistema creará un backup automático y cargará los nuevos datos</li>
                            </ul>
                        </div>
                    </div>

                    <div class="alert alert-info fs-5 mt-4" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Nota:</strong> Si tienes empleados en múltiples células, sepáralas con comas o punto y coma.
                        Ejemplo: <code>"Backend, DevOps"</code> o <code>"Frontend; UX"</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }

    .card {
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .form-control-lg {
        padding: 1.5rem 1rem;
    }

    .btn-lg {
        padding: 1rem 2rem;
        font-weight: 600;
    }

    code {
        background-color: #f8f9fa;
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
        font-size: 0.95em;
    }
</style>
